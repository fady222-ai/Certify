# Server
PORT=8000
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Secret for the tamper-evidence HMAC (use a long random value in production)
APP_KEY=change-me-to-a-long-random-secret

# Database (SQLite for dev; switch provider to postgresql in schema.prisma for prod)
DATABASE_URL="file:./dev.db"

# CORS — comma-separated allowed origins for the web frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL used to build certificate verification links
CERTIFY_VERIFY_BASE_URL=http://localhost:3000

# Optional: path to a Chrome binary; leave unset to use puppeteer's bundled Chrome
# CERTIFY_CHROME_PATH=

# Where generated certificate PDFs are stored
CERTIFY_STORAGE_DIR=storage
