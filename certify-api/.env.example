# Server
PORT=8000
APP_URL=http://localhost:8000
WEB_URL=http://localhost:3000

# Secret for JWT auth + the tamper-evidence HMAC.
# REQUIRED in production (>= 32 chars) — the server refuses to boot otherwise.
# Generate one with:  openssl rand -hex 32
APP_KEY=change-me-to-a-long-random-secret

# Database (SQLite for dev; switch provider to postgresql in schema.prisma for prod)
DATABASE_URL="file:./dev.db"

# CORS — comma-separated allowed origins for the web frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public base URL used to build certificate verification links
CERTIFY_VERIFY_BASE_URL=http://localhost:3000

# Optional: path to a Chrome binary; leave unset to use puppeteer's bundled Chrome
# CERTIFY_CHROME_PATH=

# Where generated certificate PDFs are stored
CERTIFY_STORAGE_DIR=storage

# Email — leave RESEND_API_KEY unset to log emails to the console (dev).
# Set it to send real emails via Resend (https://resend.com).
# RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="Certify <onboarding@resend.dev>"
# Set to false to disable all outgoing email.
EMAIL_ENABLED=true
